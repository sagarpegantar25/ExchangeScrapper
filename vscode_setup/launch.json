{
  // Press F5 in VS Code and pick one of these (like launch profiles in Visual Studio).
  // "Dry run" = list + download + unzip + find KIDs; no Claude, no email.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NSE dry run - date",
      "type": "debugpy", "request": "launch", "module": "src.main",
      "args": ["--exchange", "NSE", "--dry-run", "--date", "${input:runDate}"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "justMyCode": true
    },
    {
      "name": "BSE dry run - date",
      "type": "debugpy", "request": "launch", "module": "src.main",
      "args": ["--exchange", "BSE", "--dry-run", "--date", "${input:runDate}"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal", "justMyCode": true
    },
    {
      "name": "ALL dry run - date (BSE + NSE)",
      "type": "debugpy", "request": "launch", "module": "src.main",
      "args": ["--exchange", "ALL", "--dry-run", "--date", "${input:runDate}"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "ALL full run - date (skip email)",
      "type": "debugpy", "request": "launch", "module": "src.main",
      "args": ["--exchange", "ALL", "--skip-email", "--date", "${input:runDate}"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "ALL full run - date (SENDS the BSE and NSE emails)",
      "type": "debugpy", "request": "launch", "module": "src.main",
      "args": ["--exchange", "ALL", "--date", "${input:runDate}"],
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Scheduled run (HARDCODED_DATE or yesterday, sends emails)",
      "type": "debugpy", "request": "launch", "module": "src.main",
      "args": [], "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Check configuration (BSE, NSE, SMTP)",
      "type": "debugpy", "request": "launch", "module": "src.main",
      "args": ["--check"], "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Run tests (pytest)",
      "type": "debugpy", "request": "launch", "module": "pytest",
      "args": ["-v"], "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    }
  ],
  "inputs": [
    { "id": "runDate", "type": "promptString", "description": "Date (DD-MM-YYYY). BSE: allotment date, NSE: filing date", "default": "17-09-2026" }
  ]
}
