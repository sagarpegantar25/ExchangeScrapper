# =====================================================================
#  bse-kid-scraper configuration
#  Copy this file to ".env" (same folder) and fill in the values.
#  NEVER commit .env to git or email it to anyone.
#  Secrets can be left BLANK here if you store them in Windows
#  Credential Manager instead:  python -m src.main --set-secret NAME
# =====================================================================

# ---------------- Claude API ----------------
# false = don't extract with Claude yet: the KID PDFs are just attached to the email.
# Set to true (and store ANTHROPIC_API_KEY) when you're ready for extraction.
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TIMEOUT=300
CLAUDE_MAX_RETRIES=5
# Minimum seconds between API calls (rate-limit protection)
CLAUDE_MIN_INTERVAL_SEC=3
# Large KIDs are trimmed to their first N pages / N MB before sending
CLAUDE_MAX_PDF_PAGES=100
CLAUDE_MAX_PDF_MB=20

# ---------------- Email (SMTP) ----------------
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls  (use an App Password)
# Outlook/Microsoft 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURITY=starttls
# Blank = automatic. If login fails, run --diagnose-smtp; it tells you what to put here (LOGIN/PLAIN)
SMTP_AUTH_METHOD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=BSE KID Bot
# Multiple recipients: separate with commas
EMAIL_TO=
EMAIL_CC=
EMAIL_BCC=
EMAIL_SUBJECT_PREFIX=BSE Private Placement KIDs
# Send an email even when no new KIDs were found (so you know it ran)
EMAIL_SEND_WHEN_EMPTY=true
EMAIL_ATTACH_CSV=false
# Email the KIDs as a zip (BSE\KidFilesZip_<date>.zip). Max encoded size of one email's
# attachment in MB: mail.akgroup.co.in accepts 50 MB messages. A bigger zip is split into
# _part1.zip, _part2.zip... - one email each, listing the KIDs in that part. A single KID
# over the limit is split by pages (BSE\KidFilesSplit\<name>_pages1-187.pdf ...) and sent too.
EMAIL_ATTACH_KIDS=true
EMAIL_MAX_ATTACHMENTS_MB=47
EMAIL_MAX_RETRIES=3

# ---------------- BSE ----------------
# 1 = yesterday only (From = To = yesterday).
# RECOMMENDED: 3. Companies often upload their documents a day AFTER the allotment
# date (e.g. allotment 28-Sep, uploaded 29-Sep 17:45), which a yesterday-only
# 8 AM run never sees. With 3, the run checks the last 3 allotment dates, and
# duplicate detection guarantees nothing is processed or emailed twice.
LOOKBACK_DAYS=1
# Which date to search: set HARDCODED_DATE at the top of src/config.py (blank = yesterday).
# auto = JSON API first, real browser (Playwright) as fallback | api | browser
SCRAPER_MODE=auto
# Browsers to try, in order (installed Edge/Chrome work behind corporate proxies)
BROWSER_CHANNELS=msedge,chrome,chromium
# false = show the browser window (useful while debugging)
BROWSER_HEADLESS=true
# Trust the Windows certificate store (needed on networks with SSL inspection)
USE_WINDOWS_CERT_STORE=true
# 1 = Allotment Date (default on the BSE page), 2 = Redemption Date
BSE_DATE_TYPE=1
HTTP_CONNECT_TIMEOUT=30
HTTP_READ_TIMEOUT=120
DOWNLOAD_READ_TIMEOUT=600
HTTP_MAX_RETRIES=4
MAX_DOWNLOAD_MB=1024

# ---------------- ZIP / KID detection ----------------
MAX_ZIP_DEPTH=8
MAX_EXTRACTED_MB=4096
# Regexes (comma-separated) matched against PDF file names. Blank = sensible defaults.
KID_FILENAME_PATTERNS=
# If no KID is found by name, look inside PDFs for "Key Information Document"
KID_CONTENT_FALLBACK=true

# ---------------- Output folder (day-wise) ----------------
# Files go to OUTPUT_DIR\YYYY_MM_DD\ (the date searched on BSE), next to the log files:
#   BSE\<Company>_<ISIN>\        one folder per package: the zip as downloaded + unzipped\
#   BSE\KidFiles\                every KID found, named <Company>_<ISIN>_<file>.pdf
#   BSE\KidFilesZip_<date>.zip    all the KIDs zipped - this is what is emailed
#   report_*.html, results_*.csv/.json, email_*.eml   (for the whole day)
# Day folders not written to for OUTPUT_RETENTION_DAYS days are deleted (log files never are).
# Log files (bse_kid.log, errors.log, browser dumps) go to LOGS_DIR
LOGS_DIR=D:/logs
OUTPUT_DIR=D:/logs
OUTPUT_RETENTION_DAYS=3

# ---------------- Schedule & housekeeping ----------------
TIMEZONE=Asia/Kolkata
SCHEDULE_TIME=08:00
# Delete downloads/ and extracted/ folders older than N days
RETENTION_DAYS=30
# 0 = keep the KID PDF archive (processed/kids) forever
KID_ARCHIVE_RETENTION_DAYS=0
LOG_RETENTION_DAYS=90
LOG_LEVEL=INFO
# Give up on a document after N failed attempts (across runs)
MAX_DOC_ATTEMPTS=3
# false = a rerun re-processes the date and emails all its KIDs again.
# true  = skip documents/KIDs that were already emailed (no repeat emails).
SKIP_ALREADY_EMAILED=false
